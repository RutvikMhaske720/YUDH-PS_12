# ==============================================================================
# Phoenix Academic Intelligence - Comprehensive Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sensitive Environment & API Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ------------------------------------------------------------------------------
# 2. Prompt, Scratch & Raw Instruction Files (Strict Exclusion)
# ------------------------------------------------------------------------------
*prompt*.txt
*-prompt.txt
raw-prompt.txt
onboarding-content-based-prompt.txt
Problem-Statement.txt
*.prompt
scratch/
*.scratch
* (1).*
* (2).*
onboarding/studywitheila.work/
onboarding/*.html
onboarding/*.docx
*guide*.md
hackathon*
*Academic Intelligence_files/

# ------------------------------------------------------------------------------
# 3. Python Cache, Bytecode & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!**/src/lib/**

parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------------------------
