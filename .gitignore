# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.vercel
*.tsbuildinfo
next-env.d.ts

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Local Databases, Heavy Media Caches & Export Dumps
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3
.cache_ncert/
**/.cache_ncert/
textbooks/
**/textbooks/
exports/
exports/*


# ------------------------------------------------------------------------------
